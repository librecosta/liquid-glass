{
  "name": "@librecosta/liquid-glass",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Headless SVG liquid-glass refraction for native HTML, with a TypeScript core and one React Hook.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/librecosta/liquid-glass.git"
  },
  "homepage": "https://github.com/librecosta/liquid-glass#readme",
  "bugs": {
    "url": "https://github.com/librecosta/liquid-glass/issues"
  },
  "keywords": [
    "liquid-glass",
    "svg",
    "refraction",
    "headless",
    "typescript",
    "react",
    "react-hook"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && npm run build:lib && npm run build:playground",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm test && npm run build && npm run test:browser && npm run test:consumer && npm run test:distribution",
    "build:lib": "node scripts/build-lib.mjs",
    "build:playground": "vite build",
    "build:pages": "vite build --base=/liquid-glass/ --outDir=dist-pages",
    "preview:pages": "vite preview --host 127.0.0.1 --base=/liquid-glass/ --outDir=dist-pages",
    "prepack": "npm run build:lib",
    "test:consumer": "node scripts/verify-consumer.mjs",
    "test:distribution": "node scripts/verify-distribution.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/Hyalite-MIT.txt"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
